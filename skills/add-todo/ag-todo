#!/usr/bin/env bash
# ag-todo — cwd-independent wrapper for the add-todo skill CLI.
#
# Resolves its own real path through any symlinks, then execs bb with this
# package's add-todo configuration. The skill-local bb.edn declares the
# CLI's source and test paths, so the command works from any cwd.

set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$dir/$src"
done
script_dir="$(cd -P "$(dirname "$src")" && pwd)"

exec bb \
  --config "$script_dir/bb.edn" \
  --deps-root "$script_dir" \
  -m todo.cli -- "$@"
